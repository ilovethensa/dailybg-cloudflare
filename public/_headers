# Static asset caching for Cloudflare (merged with the build-generated _headers)
# Each rule: a path followed by indented headers.

# Versioned build assets: immutable, long-lived
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Icons: revalidate daily
/favicon.ico
  Cache-Control: public, max-age=86400

/favicon-16x16.png
  Cache-Control: public, max-age=86400

/favicon-32x32.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/android-chrome-192x192.png
  Cache-Control: public, max-age=86400

/android-chrome-512x512.png
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400

# Placeholder images: revalidate daily
/blog-placeholder*.jpg
  Cache-Control: public, max-age=86400

# robots.txt: revalidate daily
/robots.txt
  Cache-Control: public, max-age=86400
