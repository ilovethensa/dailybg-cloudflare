---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
	const pages = await getCollection("pages");
	return pages.map((page) => ({
		params: { slug: page.id },
		props: { page },
	}));
}

type Props = {
	page: CollectionEntry<"pages">;
};

const { page } = Astro.props;
const { Content } = await render(page);
const ogImage = page.data.heroImage ? new URL(page.data.heroImage.src, Astro.url).href : null;
---

<Base
	title={page.data.title}
	description={page.data.description}
	image={ogImage}
	canonical={`${Astro.url.origin}/pages/${page.id}`}
>
	<article class="page-article">
		<header class="page-header">
			<h1 class="page-title">{page.data.title}</h1>
		</header>

		<div class="page-content">
			<Content />
		</div>
	</article>
</Base>

<style>
	.page-article {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: var(--spacing-16) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		margin-bottom: var(--spacing-8);
	}

	.page-title {
		font-size: clamp(2rem, 5vw, var(--font-size-5xl));
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-4);
	}

	.page-content {
		font-size: var(--font-size-lg);
		line-height: var(--leading-relaxed);
	}

	.page-content :global(p) {
		margin-bottom: 1.5em;
	}

	.page-content :global(h2) {
		font-size: var(--font-size-2xl);
		margin-top: 2.5em;
		margin-bottom: 0.75em;
		scroll-margin-top: calc(var(--nav-height) + var(--spacing-4));
	}

	.page-content :global(h3) {
		font-size: var(--font-size-xl);
		margin-top: 2em;
		margin-bottom: 0.5em;
		scroll-margin-top: calc(var(--nav-height) + var(--spacing-4));
	}

	.page-content :global(blockquote) {
		margin: 2em 0;
		padding: var(--spacing-4) var(--spacing-6);
		border-left: 3px solid var(--color-border);
		background: var(--color-bg-subtle);
		border-radius: 0 var(--radius) var(--radius) 0;
		color: var(--color-text-secondary);
		font-style: italic;
	}

	.page-content :global(pre) {
		margin: 2em 0;
		padding: var(--spacing-5);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		overflow-x: auto;
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		line-height: 1.6;
	}

	.page-content :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--color-surface);
		padding: 0.2em 0.4em;
		border-radius: var(--radius);
	}

	.page-content :global(pre code) {
		background: none;
		padding: 0;
	}

	.page-content :global(ul),
	.page-content :global(ol) {
		margin-bottom: 1.5em;
		padding-left: 1.5em;
	}

	.page-content :global(li) {
		margin-bottom: 0.5em;
	}

	.page-content :global(img) {
		margin: 2em 0;
		border-radius: var(--radius-lg);
	}

	.page-content :global(hr) {
		margin: 3em 0;
		border: none;
		border-top: 1px solid var(--color-border);
	}

	.page-content :global(a) {
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
	}

	.page-content :global(a:hover) {
		text-decoration-thickness: 2px;
	}

	@media (max-width: 600px) {
		.page-title {
			font-size: var(--font-size-3xl);
		}
	}
</style>
