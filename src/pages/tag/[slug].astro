---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getPostsByTagSlug, toPostSummary } from "../../lib/posts-db";
import { tagToSlug } from "../../lib/slugs";
import { TWITTER_SITE } from "../../consts";
import { conditionalNotModified, latestModified, MIN_ARCHIVE_POSTS } from "../../lib/seo";

export const prerender = false;

const tagSlug = Astro.params.slug ?? "";

const posts = await getPostsByTagSlug(tagSlug);

if (posts.length === 0) {
	return Astro.redirect("/404");
}

const label = posts[0].tags.find((t) => tagToSlug(t) === tagSlug) ?? tagSlug;
const summaries = posts.map(toPostSummary);

const siteUrl = Astro.url.origin;
const canonical = `${siteUrl}/tag/${tagSlug}`;
const title = `${label} — новини | dailyBG`;
// Thin tag archives compete with the articles they list, so keep them out of
// the index until they have enough coverage.
const robots = posts.length < MIN_ARCHIVE_POSTS ? "noindex, follow" : null;

const lastModified = latestModified(posts);
const notModified = conditionalNotModified(Astro.request, lastModified);
if (notModified) return notModified;
if (lastModified) Astro.response.headers.set("Last-Modified", lastModified.toUTCString());
const description = `Последни новини и анализи, свързани с „${label}“ — от България и света. Всички материали по темата в dailyBG.`;

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "CollectionPage",
			name: `Публикации с таг "${label}"`,
			description,
			url: canonical,
			inLanguage: "bg-BG",
			mainEntity: {
				"@type": "ItemList",
				itemListElement: summaries.map((post, index) => ({
					"@type": "ListItem",
					position: index + 1,
					url: `${siteUrl}/posts/${post.id}`,
					name: post.title,
				})),
			},
		},
		{
			"@type": "BreadcrumbList",
			itemListElement: [
				{ "@type": "ListItem", position: 1, name: "Начало", item: `${siteUrl}/` },
				{ "@type": "ListItem", position: 2, name: label, item: canonical },
			],
		},
	],
};
---

<Base
	title={title}
	description={description}
	canonical={canonical}
	robots={robots}
	twitterSite={TWITTER_SITE}
	jsonLd={jsonLd}
>
	<section class="archive-section">
		<header class="archive-header">
			<span class="archive-label">Таг</span>
			<h1 class="archive-title">{label}</h1>
			<p class="archive-count">
				{summaries.length}
				{summaries.length === 1 ? "публикация" : summaries.length < 5 ? "публикации" : "публикации"}
			</p>
		</header>

		{
			summaries.length === 0 ? (
				<p class="no-posts">Все още няма публикации с този таг.</p>
			) : (
				<div class="posts-grid">
					{summaries.map((item) => (
						<PostCard
							title={item.title}
							excerpt={item.excerpt}
							heroImage={item.image}
							href={item.href}
							date={item.date}
							readingTime={item.readingTime}
							tags={item.tags}
							author={item.author}
						/>
					))}
				</div>
			)
		}
	</section>
</Base>

<style>
	.archive-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6);
	}

	.archive-header {
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.archive-label {
		display: block;
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-brand);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		margin-bottom: var(--spacing-2);
	}

	.archive-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.archive-count {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	.no-posts {
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
