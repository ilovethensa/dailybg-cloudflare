---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getPostsByTag, getUniqueTags, getAllPosts, toPostSummary } from "../../lib/posts-db";

export const prerender = false;

type Props = {
	label: string;
};

const { label } = Astro.props;
const posts = await getPostsByTag(label);
const allPosts = await getAllPosts();
const tags = getUniqueTags(allPosts).map((tag) => ({ slug: tag.toLowerCase().replace(/[^a-z0-9]+/g, "-"), label: tag }));
const summaries = posts.map(toPostSummary);
---

<Base title={`Posts tagged "${label}"`} description={`All posts tagged with ${label}`} {tags}>
	<section class="archive-section">
		<header class="archive-header">
			<span class="archive-label">Tag</span>
			<h1 class="archive-title">{label}</h1>
			<p class="archive-count">
				{summaries.length}
				{summaries.length === 1 ? "post" : "posts"}
			</p>
		</header>

		{
			summaries.length === 0 ? (
				<p class="no-posts">No posts with this tag yet.</p>
			) : (
				<div class="posts-grid">
					{summaries.map((item) => (
						<PostCard
							title={item.title}
							excerpt={item.excerpt}
							heroImage={item.image}
							href={item.href}
							date={item.date}
							readingTime={item.readingTime}
							tags={item.tags}
							author={item.author}
						/>
					))}
				</div>
			)
		}
	</section>
</Base>

<style>
	.archive-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6);
	}

	.archive-header {
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.archive-label {
		display: block;
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-brand);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		margin-bottom: var(--spacing-2);
	}

	.archive-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.archive-count {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	.no-posts {
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
