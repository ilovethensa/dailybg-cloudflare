---
import Base from "../layouts/Base.astro";
import { SITE_DESCRIPTION, SITE_TITLE, TWITTER_SITE } from "../consts";
import { getAllPosts, toPostSummary } from "../lib/posts-db";

export const prerender = false;

const posts = await getAllPosts();
const items = posts.map(toPostSummary);
const [lead, side, ...rest] = items;
const stories = rest.slice(0, 3);
const briefing = rest.slice(3, 6);
const longRead = rest[6] ?? null;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: SITE_TITLE,
	url: Astro.url.origin,
	potentialAction: {
		"@type": "SearchAction",
		target: {
			"@type": "EntryPoint",
			urlTemplate: `${Astro.url.origin}/search?q={search_term_string}`,
		},
		"query-input": "required name=search_term_string",
	},
};
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION} twitterSite={TWITTER_SITE} jsonLd={jsonLd}>
  <!-- Visually hidden site heading so the page has exactly one h1 -->
  <h1 class="sr-only">{SITE_TITLE}</h1>
  <!-- Micro-styles from target -->
  <style>
    .article-border-b { border-bottom: 1px solid #e0e0e0; }
    .article-border-r { border-right: 1px solid #e0e0e0; }
    .hover-underline:hover .headline-text { text-decoration: underline; text-underline-offset: 4px; }
    .headline-text a { color: inherit; }
  </style>

  {items.length === 0 ? (
    <section class="empty-state py-12 text-center">
      <h2 class="text-2xl mb-2">Все още няма публикации</h2>
      <p class="text-on-surface-variant mb-4">Добавете публикации в D1 базата данни, за да ги видите тук.</p>
    </section>
  ) : (
    <div class="max-w-[1280px] mx-auto px-margin-mobile md:px-margin-desktop bg-surface-bright text-primary">
        <!-- Feature Section (Asymmetrical Grid) -->
        <section class="grid grid-cols-1 md:grid-cols-12 article-border-b">
          {lead && (
            <article class="md:col-span-8 md:pr-gutter hover-underline cursor-pointer group py-stack-md">
              <a href={lead.href} class="mb-stack-md overflow-hidden block">
                {lead.image ? (
                  <img src={lead.image} class="w-full h-[300px] md:h-[500px] object-cover transition-transform duration-700 group-hover:scale-105" alt={lead.title} width="1920" height="1080" fetchpriority="high" />
                  ) : (
                    <div class="w-full h-[300px] md:h-[500px] bg-surface"></div>
                  )}
              </a>
              <div class="flex flex-col gap-2">
                <span class="text-label-sm font-label-sm text-on-surface-variant uppercase">
                  {lead.tags[0]?.label ?? "Избрани"} • {lead.readingTime} мин четене
                </span>
                <h2 class="font-headline-xl text-headline-xl headline-text leading-tight wrap-anywhere md:wrap-normal">
                  <a href={lead.href}>{lead.title}</a>
                </h2>
                {lead.excerpt && <p class="font-article-body text-secondary mt-stack-sm max-w-2xl text-meta-ui">{lead.excerpt}</p>}
                <div class="mt-4 flex items-center gap-2">
                  {lead.author && <span class="font-meta-ui font-bold">{lead.author}</span>}
                  <span class="text-outline">•</span>
                  <span class="font-meta-ui text-on-surface-variant">{lead.date.toLocaleDateString("bg-BG", { year: "numeric", month: "long", day: "numeric" })}</span>
                </div>
              </div>
            </article>
          )}

          {side && (
            <article class="md:col-span-4 md:pl-gutter hover-underline cursor-pointer group py-stack-md">
              <div class="flex flex-col h-full justify-between">
                <div>
                  <span class="text-label-sm font-label-sm text-on-surface-variant uppercase">
                    {"Политика"} • {side.tags[0]?.label ?? "Изпратено"}
                  </span>
                  <h3 class="font-headline-lg text-headline-lg headline-text mt-2 leading-snug">
                    <a href={side.href}>{side.title}</a>
                  </h3>
                  {side.image && (
                    <div class="my-stack-md">
                      <a href={side.href} class="block overflow-hidden">
                        <img src={side.image} class="w-full h-40 md:h-64 object-cover" alt={side.title} width="1920" height="1080" loading="lazy" />
                      </a>
                    </div>
                  )}
                  {side.excerpt && <p class="font-meta-ui text-on-surface-variant leading-relaxed">{side.excerpt}</p>}
                </div>
                <div class="mt-stack-lg pt-stack-md border-t border-outline-variant">
                  {side.author && <span class="font-meta-ui font-bold">{side.author}</span>}
                </div>
              </div>
            </article>
          )}
        </section>

        <!-- Secondary Grid (3 Columns) -->
        <section class="grid grid-cols-1 md:grid-cols-3 article-border-b">
          {stories.map((story, idx) => {
            const isTextOnly = idx === 2;
            return isTextOnly ? (
              <article class="md:pl-gutter hover-underline cursor-pointer py-stack-md">
                <div class="flex flex-col justify-center h-full">
                  <span class="text-label-sm font-label-sm text-error uppercase font-bold">
                     {story.tags[0]?.label ?? "Икономически анализ"}
                  </span>
                  <h4 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg headline-text mt-2 leading-snug">
                    <a href={story.href}>{story.title}</a>
                  </h4>
                  {story.excerpt && (
                    <>
                      <p class="font-article-body text-article-body text-on-surface-variant mt-4 italic leading-relaxed">“{story.excerpt}”</p>
                      <p class="font-meta-ui text-on-surface-variant mt-4 leading-relaxed">{story.excerpt}</p>
                    </>
                  )}
                  <div class="mt-6 flex items-center gap-2">
                    {story.author && <span class="font-meta-ui font-bold">{story.author}</span>}
                  </div>
                </div>
              </article>
            ) : (
              <article class={`md:pr-gutter md:article-border-r hover-underline cursor-pointer group py-stack-md${idx === 1 ? " md:px-gutter" : ""}`}>
                <a href={story.href} class="mb-stack-md block overflow-hidden">
                  {story.image ? (
                    <img src={story.image} class="w-full h-40 md:h-48 object-cover" alt={story.title} width="1920" height="1080" loading="lazy" />
                  ) : (
                    <div class="w-full h-40 md:h-48 bg-surface"></div>
                  )}
                </a>
                <span class="text-label-sm font-label-sm text-on-surface-variant uppercase">
                   {story.tags[0]?.label ?? "История"}
                </span>
                <h4 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg headline-text mt-2 leading-snug">
                  <a href={story.href}>{story.title}</a>
                </h4>
                {story.excerpt && <p class="font-meta-ui text-on-surface-variant mt-3 leading-relaxed">{story.excerpt}</p>}
                <div class="mt-4 flex items-center gap-2">
                  {story.author && <span class="font-meta-ui font-bold">{story.author}</span>}
                </div>
              </article>
            );
          })}
        </section>

        <!-- Briefs & Long Read -->
        <section class="grid grid-cols-1 md:grid-cols-4 gap-gutter py-stack-md">
          <div class="col-span-1">
            <h5 class="text-label-sm font-label-sm uppercase border-b border-primary pb-2 mb-stack-md">Брифинг</h5>
            <ul class="flex flex-col gap-stack-md">
              {briefing.map((b) => (
                <li class="hover:opacity-70 transition-opacity cursor-pointer">
                  <a href={b.href}>
                    <p class="font-meta-ui font-bold leading-tight">{b.title}</p>
                    <span class="text-label-sm text-on-surface-variant">
                      {b.date.toLocaleTimeString("bg-BG", { hour: "numeric", minute: "2-digit" }) || `${b.readingTime} мин`}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          {longRead && (
            <article class="md:col-span-3 flex flex-col md:flex-row gap-gutter group cursor-pointer border-l border-outline-variant md:pl-gutter">
              <div class="md:w-1/2">
                <span class="text-label-sm font-label-sm text-on-surface-variant uppercase">Дълго четене</span>
                <h4 class="font-headline-xl text-headline-lg-mobile md:text-headline-lg headline-text mt-2">
                  <a href={longRead.href}>{longRead.title}</a>
                </h4>
                {longRead.excerpt && <p class="font-meta-ui text-on-surface-variant mt-4 leading-relaxed">{longRead.excerpt}</p>}
                <div class="mt-4">
                  <a href={longRead.href} class="font-meta-ui font-bold underline">Прочетете специалния доклад →</a>
                </div>
              </div>
              <div class="md:w-1/2 bg-surface-container overflow-hidden">
                {longRead.image ? (
                    <a
                      href={longRead.href}
                      class="block w-full h-full min-h-[200px] md:min-h-[300px] bg-cover bg-center grayscale group-hover:grayscale-0 transition-all duration-1000"
                      style={`background-image: url('${longRead.image}')`}
                    ></a>
                ) : (
                  <div class="w-full h-full min-h-[200px] md:min-h-[300px] bg-surface"></div>
                )}
              </div>
            </article>
          )}
        </section>
    </div>
  )}
</Base>
