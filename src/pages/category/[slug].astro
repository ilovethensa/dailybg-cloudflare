---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { slugify } from "../../utils/slugify";
import { sortPosts, toPostSummary } from "../../utils/posts";

export async function getStaticPaths() {
	const posts = await getCollection("posts");
	const labels = new Set<string>();
	for (const post of posts) {
		if (post.data.category) labels.add(post.data.category);
	}
	return Array.from(labels).map((label) => ({
		params: { slug: slugify(label) },
		props: { label },
	}));
}

type Props = {
	label: string;
};

const { label } = Astro.props;
const posts = sortPosts(await getCollection("posts")).filter(
	(post) => !post.data.draft && post.data.category === label,
);
const summaries = posts.map(toPostSummary);
---

<Base title={`${label} posts`} description={`All posts in ${label}`}>
	<section class="archive-section">
		<header class="archive-header">
			<span class="archive-label">Category</span>
			<h1 class="archive-title">{label}</h1>
			<p class="archive-count">
				{summaries.length}
				{summaries.length === 1 ? "post" : "posts"}
			</p>
		</header>

		{
			summaries.length === 0 ? (
				<p class="no-posts">No posts in this category yet.</p>
			) : (
				<div class="posts-grid">
					{summaries.map((item) => (
						<PostCard
							title={item.title}
							excerpt={item.excerpt}
							heroImage={item.image}
							href={item.href}
							date={item.date}
							readingTime={item.readingTime}
							tags={item.tags}
							author={item.author}
							category={{ slug: slugify(label), label }}
						/>
					))}
				</div>
			)
		}
	</section>
</Base>

<style>
	.archive-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6);
	}

	.archive-header {
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.archive-label {
		display: block;
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-brand);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		margin-bottom: var(--spacing-2);
	}

	.archive-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.archive-count {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	.no-posts {
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
