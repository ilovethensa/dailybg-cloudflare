---
import Base from "../../layouts/Base.astro";
import { getAllPosts, toPostSummary } from "../../lib/posts-db";

export const prerender = false;

const posts = await getAllPosts();
const summaries = posts.map(toPostSummary);

const formatDate = (date: Date) =>
	date.toLocaleDateString("bg-BG", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});

const formatMonth = (date: Date) =>
	date.toLocaleDateString("bg-BG", {
		year: "numeric",
		month: "long",
	});

type YearMonthGroup = {
	year: number;
	month: number;
	label: string;
	posts: typeof summaries;
};

const grouped: YearMonthGroup[] = [];
for (const post of summaries) {
	const year = post.date.getFullYear();
	const month = post.date.getMonth();
	const existing = grouped.find((g) => g.year === year && g.month === month);
	if (existing) {
		existing.posts.push(post);
	} else {
		grouped.push({
			year,
			month,
			label: formatMonth(post.date),
			posts: [post],
		});
	}
}

const years = Array.from(new Set(grouped.map((g) => g.year))).sort((a, b) => b - a);

const selectedYear = Astro.url.searchParams.get("year");
const filteredGrouped =
	selectedYear !== null
		? grouped.filter((g) => g.year === Number(selectedYear))
		: grouped;
---

<Base title="Всички публикации" description="Всички статии">
	<div class="posts-page">
		<header class="page-header">
			<span class="page-kicker">Архив</span>
			<h1 class="page-title">Всички публикации</h1>
			<p class="page-description">
				{posts.length}
				{posts.length === 1 ? "статия" : posts.length < 5 ? "статии" : "статии"}
			</p>
			{years.length > 1 && (
				<div class="year-filter">
					<button
						class="year-btn"
						class:active={selectedYear === null}
						data-year="all"
					>
						Всички
					</button>
					{years.map((year) => (
						<a
							href={`?year=${year}`}
							class="year-btn"
							class:active={selectedYear === String(year)}
						>
							{year}
						</a>
					))}
				</div>
			)}
		</header>

		{
			filteredGrouped.length === 0 ? (
				<p class="empty">Няма публикации за тази година.</p>
			) : (
				<div class="posts-list">
					{filteredGrouped.map((group) => (
						<section class="year-group">
							<h2 class="group-title">{group.label}</h2>
							{group.posts.map((item) => (
								<article class="post-item">
									<a href={item.href} class="post-link">
										<div class="post-topline">
											{item.category && (
												<a href={`/category/${item.category.slug}`} class="post-kicker">
													{item.category.label}
												</a>
											)}
											<time class="post-date">{formatDate(item.date)}</time>
										</div>
										<h3 class="post-title">{item.title}</h3>
										{item.excerpt && <p class="post-excerpt">{item.excerpt}</p>}
										<div class="post-meta">
											{item.author && <span class="post-byline">{item.author}</span>}
											<span>{item.readingTime} мин четене</span>
										</div>
									</a>
									{item.tags.length > 0 && (
										<div class="post-tags">
											{item.tags.slice(0, 3).map((tag) => (
												<a href={`/tag/${tag.slug}`} class="post-tag">
													{tag.label}
												</a>
											))}
										</div>
									)}
								</article>
							))}
						</section>
					))}
				</div>
			)
		}
	</div>
</Base>

<style>
	.posts-page {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.page-kicker {
		display: block;
		font-size: var(--font-size-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-brand);
		margin-bottom: var(--spacing-2);
	}

	.page-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.page-description {
		font-size: var(--font-size-lg);
		color: var(--color-muted);
		margin-bottom: var(--spacing-4);
	}

	.year-filter {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
	}

	.year-btn {
		padding: var(--spacing-2) var(--spacing-4);
		border-radius: var(--radius);
		font-size: var(--font-size-sm);
		font-weight: 500;
		text-decoration: none;
		color: var(--color-text-secondary);
		background: transparent;
		border: 1px solid var(--color-border);
		transition:
			background var(--transition-fast),
			color var(--transition-fast),
			border-color var(--transition-fast);
	}

	.year-btn:hover {
		background: var(--color-surface);
		color: var(--color-text);
	}

	.year-btn.active {
		background: var(--color-brand);
		color: var(--color-on-brand);
		border-color: var(--color-brand);
	}

	.empty {
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	.posts-list {
		display: flex;
		flex-direction: column;
	}

	.year-group {
		margin-bottom: var(--spacing-12);
	}

	.group-title {
		font-size: var(--font-size-xl);
		font-weight: var(--font-weight-heading);
		letter-spacing: var(--tracking-snug);
		margin-bottom: var(--spacing-6);
		padding-bottom: var(--spacing-3);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.post-item {
		padding: var(--spacing-6) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.post-item:first-child {
		padding-top: 0;
	}

	.post-item:last-child {
		border-bottom: none;
	}

	.post-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.post-topline {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		margin-bottom: var(--spacing-2);
	}

	.post-kicker {
		font-size: var(--font-size-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		color: var(--color-brand);
		text-decoration: none;
	}

	.post-kicker:hover {
		color: var(--color-brand-hover);
	}

	.post-date {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.post-title {
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
	}

	.post-link:hover .post-title {
		color: var(--color-brand);
	}

	.post-excerpt {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		max-width: 60ch;
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		margin-top: var(--spacing-3);
	}

	.post-byline {
		font-weight: 500;
		color: var(--color-text-secondary);
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		margin-top: var(--spacing-4);
	}

	.post-tag {
		display: inline-block;
		padding: var(--tag-padding-y) var(--spacing-2);
		font-size: var(--font-size-xs);
		color: var(--color-text-secondary);
		background: var(--color-surface);
		border-radius: var(--radius);
		text-decoration: none;
		transition:
			color var(--transition-fast),
			background var(--transition-fast);
	}

	.post-tag:hover {
		color: var(--color-text);
		background: var(--color-border);
	}

	@media (max-width: 600px) {
		.posts-page {
			padding: var(--spacing-8) var(--spacing-4) var(--spacing-12);
		}

		.page-title {
			font-size: var(--font-size-3xl);
		}

		.post-title {
			font-size: var(--font-size-xl);
		}
	}
</style>
