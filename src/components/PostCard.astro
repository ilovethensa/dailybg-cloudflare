---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	title: string;
	excerpt?: string;
	/** ImageMetadata for local assets, or an absolute URL string for remote images */
	heroImage?: ImageMetadata | string;
	href: string;
	date?: Date;
	readingTime?: number;
	tags?: Array<{ slug: string; label: string }>;
	author?: string;
}

const { title, excerpt, heroImage, href, date, readingTime, tags, author } = Astro.props;

const formattedDate = date
	? date.toLocaleDateString("bg-BG", {
			year: "numeric",
			month: "short",
			day: "numeric",
		})
	: null;

const imgSrc = typeof heroImage === "string" ? heroImage : heroImage?.src;
---

<article class="post-card">
	<a href={href} class="card-link">
		{imgSrc ? (
			<div class="card-image">
				<img src={imgSrc} alt={title} />
			</div>
		) : (
			<div class="card-placeholder" />
		)}
		<div class="card-body">
			<div class="card-meta">
				{formattedDate && <time class="card-date">{formattedDate}</time>}
				{author && (
					<>
						{formattedDate && <span class="meta-dot" />}
						<span class="card-byline-name">{author}</span>
					</>
				)}
				{readingTime && (
					<>
						<span class="meta-dot" />
						<span>{readingTime} мин</span>
					</>
				)}
			</div>
			<h2 class="card-title">{title}</h2>
			{excerpt && <p class="card-excerpt">{excerpt}</p>}
		</div>
	</a>
	{tags && tags.length > 0 && (
		<div class="card-tags">
			{tags.slice(0, 2).map((tag) => (
				<a href={`/tag/${tag.slug}`} class="card-tag">
					{tag.label}
				</a>
			))}
		</div>
	)}
</article>

<style>
	.post-card {
		display: flex;
		flex-direction: column;
	}

	.card-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.card-image {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		margin-bottom: var(--spacing-4);
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.card-link:hover .card-image img {
		transform: scale(1.03);
	}

	.card-placeholder {
		aspect-ratio: 16 / 10;
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		margin-bottom: var(--spacing-4);
	}

	.card-body {
		flex: 1;
	}

	.card-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		column-gap: var(--spacing-3);
		row-gap: 0;
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		margin-bottom: var(--spacing-2);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
	}

	.card-meta time,
	.card-meta span:not(.meta-dot) {
		white-space: nowrap;
	}

	.meta-dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--color-muted);
	}

	.card-date {
		color: var(--color-muted);
	}

	.card-byline-name {
		font-weight: 500;
		color: var(--color-text-secondary);
	}

	.card-title {
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		letter-spacing: var(--tracking-snug);
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
	}

	.card-link:hover .card-title {
		color: var(--color-brand);
	}

	.card-excerpt {
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		margin-top: var(--spacing-3);
	}

	.card-tag {
		display: inline-block;
		padding: var(--tag-padding-y) var(--spacing-2);
		font-size: var(--font-size-xs);
		color: var(--color-text-secondary);
		background: var(--color-surface);
		border-radius: var(--radius);
		text-decoration: none;
		transition:
			color var(--transition-fast),
			background var(--transition-fast);
	}

	.card-tag:hover {
		color: var(--color-text);
		background: var(--color-border);
	}
</style>
