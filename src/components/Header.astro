---
interface Props {
	siteTitle: string;
}

const { siteTitle } = Astro.props;
---

<header class="bg-surface border-b border-outline-variant sticky top-0 z-50">
	<div
		class="flex flex-col md:flex-row justify-between items-center w-full max-w-[1280px] mx-auto py-2 px-margin-desktop"
	>
		<div class="flex items-center gap-6">
			<a
				href="/"
				class="font-headline-xl text-headline-xl font-bold tracking-tighter text-primary uppercase"
				>{siteTitle}</a
			>
		</div>
		<nav class="flex flex-col md:flex-row items-center gap-stack-md">
			<a
				class="font-navigation text-navigation text-secondary hover:text-primary"
				href="/pages/about"
			>
				About
			</a>
			<a
				class="font-navigation text-navigation text-secondary hover:text-primary"
				href="/pages/contact"
			>
				Contact
			</a>
		</nav>
	</div>
</header>
