---
interface Props {
	siteTitle: string;
	tags: Array<{ slug: string; label: string }>;
}

const { siteTitle, tags } = Astro.props;
---

<header class="bg-surface border-b border-outline-variant sticky top-0 z-50">
	<div
		class="flex flex-col md:flex-row justify-between items-center w-full max-w-[1280px] mx-auto py-2 px-margin-desktop"
	>
		<div class="flex items-center gap-6">
			<a
				href="/"
				class="font-headline-xl text-headline-xl font-bold tracking-tighter text-primary uppercase"
				>{siteTitle}</a
			>
		</div>
		<nav class="hidden md:flex items-center gap-stack-md">
			{tags.map((tag, i) => (
				<a
					class={`font-navigation text-navigation ${
						i === 0 ? "text-primary border-b border-primary pb-1" : "text-secondary hover:text-primary"
					}`}
					href={`/tag/${tag.slug}`}
				>
					{tag.label}
				</a>
			))}
		</nav>
		<div class="flex items-center gap-stack-md">
			<a href="/search" class="material-symbols-outlined cursor-pointer hover:text-primary">search</a>
			<a
				href="/search"
				class="bg-primary text-on-primary px-4 py-2 font-navigation text-navigation uppercase tracking-wider hover:opacity-90"
				>Subscribe</a
			>
		</div>
	</div>
</header>
