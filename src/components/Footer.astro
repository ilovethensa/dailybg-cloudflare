---
interface Props {
	siteTitle: string;
}

const { siteTitle } = Astro.props;
---

<footer class="border-t border-outline-variant">
	<div
		class="flex flex-col items-center gap-stack-md w-full max-w-[1280px] mx-auto py-stack-md px-margin-desktop"
	>
		<h2 class="font-headline-lg text-headline-lg text-primary uppercase font-bold tracking-tighter">
			{siteTitle}
		</h2>
		<nav class="flex flex-wrap justify-center gap-x-8 gap-y-2">
			<a class="font-meta-ui text-on-surface-variant hover:underline" href="/pages/about">За нас</a>
			<a class="font-meta-ui text-on-surface-variant hover:underline" href="/pages/contact">Контакти</a>
			<a class="font-meta-ui text-on-surface-variant hover:underline" href="/posts">Архив</a>
			<a class="font-meta-ui text-on-surface-variant hover:underline" href="/pages/careers">Кариери</a>
		</nav>
		<div class="mt-stack-sm flex flex-col items-center gap-2">
			<div class="flex gap-4">
				<span class="material-symbols-outlined text-secondary cursor-pointer hover:text-primary">language</span>
				<span class="material-symbols-outlined text-secondary cursor-pointer hover:text-primary">share</span>
				<span class="material-symbols-outlined text-secondary cursor-pointer hover:text-primary">mail</span>
			</div>
			<p class="font-meta-ui text-on-surface-variant text-[12px] opacity-60">
				© 2024 {siteTitle}. ВСИЧКИ ПРАВА ЗАПАЗЕНИ.
			</p>
		</div>
	</div>
</footer>
